<mxfile host="app.diagrams.net"><diagram name="Check-in com baixa de stock (geral)" id="sd"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s24" value="sd Check-in com baixa de stock (geral)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=320;height=28;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fillColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1230" height="800" as="geometry"/></mxCell><mxCell id="s15" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="294" width="778" height="122" as="geometry"/></mxCell><mxCell id="s16" value="[é preciso mudar uma quantidade]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="108" y="298" width="600" height="18" as="geometry"/></mxCell><mxCell id="s17" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fillColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="482" width="778" height="238" as="geometry"/></mxCell><mxCell id="s18" value="[cancelada, já com check-in, outro dia ou antes da hora]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="108" y="486" width="600" height="18" as="geometry"/></mxCell><mxCell id="s19" value="[falta stock de algum material]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="108" y="566" width="600" height="18" as="geometry"/></mxCell><mxCell id="s20" value="[senão]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="108" y="642" width="600" height="18" as="geometry"/></mxCell><mxCell id="s21" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="570" as="sourcePoint"/><mxPoint x="820" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s22" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="646" as="sourcePoint"/><mxPoint x="820" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s11" value="Rececionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="102" y="50" width="30" height="55" as="geometry"/></mxCell><mxCell id="s12" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="130" as="sourcePoint"/><mxPoint x="117" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s13" value=":Sistema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFE0;strokeColor=#000000;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="110" height="36" as="geometry"/></mxCell><mxCell id="s14" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="96" as="sourcePoint"/><mxPoint x="675" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1" value="1: procurarReservas(nome, NIF ou quarto)" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="150" as="sourcePoint"/><mxPoint x="675" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2" value="2: reservas por fazer, em curso e histórico" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="186" as="sourcePoint"/><mxPoint x="117" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3" value="3: verMateriais(reserva)" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="222" as="sourcePoint"/><mxPoint x="675" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4" value="4: materiais do tipo de quarto (ou os já ajustados)" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="258" as="sourcePoint"/><mxPoint x="117" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5" value="5: ajustarQuantidade(material, quantidade)" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="340" as="sourcePoint"/><mxPoint x="675" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s6" value="6: materiais da reserva atualizados" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="376" as="sourcePoint"/><mxPoint x="117" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s7" value="7: fazerCheckin(reserva)" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="446" as="sourcePoint"/><mxPoint x="675" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s8" value="8: erro com o motivo" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="528" as="sourcePoint"/><mxPoint x="117" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s9" value="9: erro: não há stock suficiente (material, precisa, há)" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="604" as="sourcePoint"/><mxPoint x="117" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s10" value="10: check-in feito: entregar o cartão C + número do quarto" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="680" as="sourcePoint"/><mxPoint x="117" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s23" value="&lt;b&gt;Pré-condição:&lt;/b&gt; rececionista ou gestor autenticado. O sistema é visto como caixa preta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Regras (US35 e US76):&lt;/b&gt;&lt;br&gt;• só no dia de entrada, a partir da hora de check-in (ou de early check-in);&lt;br&gt;• os materiais vêm da configuração do tipo de quarto, ou dos ajustados nessa reserva;&lt;br&gt;• os consumíveis saem do stock de vez; os outros saem como saída temporária, que volta no check-out;&lt;br&gt;• o check-in e a baixa de stock são gravados juntos: se faltar stock, nada é gravado." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A660;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="360" height="199" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>