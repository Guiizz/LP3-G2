height="125" as="geometry"/></mxCell><mxCell id="MovimentoStock_a" value="quantidade&lt;br&gt;registadoEm&lt;br&gt;tipo (temporária ou definitiva)&lt;br&gt;motivo&lt;br&gt;devolvidaEm" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="MovimentoStock"><mxGeometry y="30" width="245" height="95" as="geometry"/></mxCell><mxCell id="n7" value="Estado da reserva: Confirmada → Em curso (check-in) → Concluída (check-out); uma Confirmada também pode passar a Cancelada.&lt;br&gt;&lt;br&gt;Os detalhes da reserva mostram o cliente, o quarto, as datas, o early check-in e o late check-out, os serviços, o cartão e o total.&lt;br&gt;&lt;br&gt;O gestor só apaga reservas sem check-in (confirmadas ou canceladas)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A660;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="545" width="300" height="195" as="geometry"/></mxCell><mxCell id="n8" value="Cartões: cliente = C + quarto (C201); funcionário = F + número (F12); restauração = R + número (R3); mestre = C000.&lt;br&gt;&lt;br&gt;F só abre os pisos 0 e 1; R só abre a cozinha e o restaurante." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A660;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="690" width="170" height="172" as="geometry"/></mxCell><mxCell id="n9" value="Locais por piso:&lt;br&gt;-1: garagem e armazém&lt;br&gt;0: bar e salas de conferência&lt;br&gt;1: restaurante, piscina e cozinha&lt;br&gt;2 e 3: quartos" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;fillColor=#FFF8DC;strokeColor=#B8A660;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="10