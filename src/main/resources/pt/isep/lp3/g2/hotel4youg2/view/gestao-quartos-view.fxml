<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.GestaoQuartosController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Gestão de quartos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Número" prefWidth="80.0">
                <cellValueFactory><PropertyValueFactory property="numero"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Piso" prefWidth="60.0">
                <cellValueFactory><PropertyValueFactory property="piso"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Tipo" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="tipo"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Vista" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="vista"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Estado" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Desativar" onAction="#aoDesativar"/>
        <Button text="Reativar" onAction="#aoReativar"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>