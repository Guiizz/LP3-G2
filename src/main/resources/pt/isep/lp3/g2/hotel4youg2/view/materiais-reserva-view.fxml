<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.MateriaisReservaController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="← Voltar" onAction="#aoVoltar"/>
        <Label fx:id="tituloLabel" styleClass="titulo"/>
    </HBox>

    <Label fx:id="infoLabel" wrapText="true"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS" minHeight="160.0">
        <placeholder>
            <Label text="O tipo deste quarto ainda não tem materiais configurados (Quartos → Materiais dos quartos)."/>
        </placeholder>
        <columns>
            <TableColumn text="Código" prefWidth="100.0">
                <cellValueFactory><PropertyValueFactory property="codigo"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Material" prefWidth="260.0">
                <cellValueFactory><PropertyValueFactory property="descricao"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Fornecedor" prefWidth="160.0">
                <cellValueFactory><PropertyValueFactory property="fornecedor"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Tipo" prefWidth="130.0">
                <cellValueFactory><PropertyValueFactory property="consumivelTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Quantidade" prefWidth="100.0">
                <cellValueFactory><PropertyValueFactory property="quantidade"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox fx:id="ajustarBox" spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Nova quantidade do material escolhido:"/>
        <TextField fx:id="quantidadeField" promptText="0 a 99" prefWidth="80.0" onAction="#aoAlterarQuantidade"/>
        <Button text="Alterar quantidade" onAction="#aoAlterarQuantidade"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
