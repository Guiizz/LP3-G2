<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.ConsultarSugestoesController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Sugestões e queixas" styleClass="titulo"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Tipo:"/>
        <ComboBox fx:id="tipoCombo" promptText="Todos" onAction="#aoFiltrar" prefWidth="140.0"/>
        <Button text="Limpar filtro" onAction="#aoLimpar"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Data" prefWidth="120.0">
                <cellValueFactory><PropertyValueFactory property="registadaEmTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Tipo" prefWidth="80.0">
                <cellValueFactory><PropertyValueFactory property="tipo"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Cliente" prefWidth="150.0">
                <cellValueFactory><PropertyValueFactory property="nomeCliente"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Descrição" prefWidth="330.0">
                <cellValueFactory><PropertyValueFactory property="descricao"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>