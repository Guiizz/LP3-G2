<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.DisponibilidadeController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Entrada:"/>
        <DatePicker fx:id="entradaPicker" prefWidth="130"/>
        <Label text="Saída:"/>
        <DatePicker fx:id="saidaPicker" prefWidth="130"/>
        <Label text="Hóspedes:"/>
        <Spinner fx:id="hospedesSpinner" min="1" max="4" initialValue="1" prefWidth="70"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Tipo:"/>
        <ComboBox fx:id="tipoCombo" promptText="Todos"/>
        <Label text="Vista:"/>
        <ComboBox fx:id="vistaCombo" promptText="Todas"/>
        <Button text="Limpar filtros" onAction="#aoLimparFiltros"/>
        <Button text="Pesquisar" onAction="#aoPesquisar" defaultButton="true"/>
    </HBox>

    <TableView fx:id="quartosTabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Número">
                <cellValueFactory><PropertyValueFactory property="numero"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Piso">
                <cellValueFactory><PropertyValueFactory property="piso"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Tipo">
                <cellValueFactory><PropertyValueFactory property="tipo"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Vista">
                <cellValueFactory><PropertyValueFactory property="vista"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Capacidade">
                <cellValueFactory><PropertyValueFactory property="capacidade"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Preço/noite (€)">
                <cellValueFactory><PropertyValueFactory property="valorNoite"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="mensagemLabel"/>

</VBox>