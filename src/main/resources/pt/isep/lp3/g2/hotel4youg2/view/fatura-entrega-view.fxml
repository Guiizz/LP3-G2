<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.FaturaEntregaController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="tituloLabel" styleClass="titulo"/>
        <Label fx:id="estadoLabel" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Voltar" onAction="#aoVoltar"/>
    </HBox>

    <GridPane hgap="10.0" vgap="6.0">
        <Label text="Fornecedor:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="fornecedorLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="NIF / Identificador:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="nifLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Morada:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="moradaLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Encomenda:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label fx:id="encomendaLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Data da encomenda:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Label fx:id="dataLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <Label text="Moeda:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Label fx:id="moedaLabel" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
    </GridPane>

    <Separator/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS" prefHeight="300.0">
        <columns>
            <TableColumn text="Código" prefWidth="85.0">
                <cellValueFactory><PropertyValueFactory property="codigoProduto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Material" prefWidth="230.0">
                <cellValueFactory><PropertyValueFactory property="descricao"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Quantidade" prefWidth="80.0">
                <cellValueFactory><PropertyValueFactory property="quantidade"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Unidade" prefWidth="75.0">
                <cellValueFactory><PropertyValueFactory property="unidadeTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Preço unitário" prefWidth="95.0">
                <cellValueFactory><PropertyValueFactory property="precoUnitarioTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Valor sem IVA" prefWidth="100.0">
                <cellValueFactory><PropertyValueFactory property="valorSemIvaTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Taxa IVA" prefWidth="70.0">
                <cellValueFactory><PropertyValueFactory property="taxaIvaTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Valor IVA" prefWidth="85.0">
                <cellValueFactory><PropertyValueFactory property="valorIvaTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Total" prefWidth="95.0">
                <cellValueFactory><PropertyValueFactory property="totalLinhaTexto"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <GridPane hgap="15.0" vgap="4.0">
            <Label text="Total sem IVA:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="totalSemIvaLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="IVA:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="totalIvaLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Total:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="totalLabel" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </HBox>

    <Label fx:id="avisoLabel" wrapText="true"/>
</VBox>
