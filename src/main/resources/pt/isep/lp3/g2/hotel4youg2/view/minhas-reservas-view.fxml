<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="ecra" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.MinhasReservasController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="As minhas reservas" styleClass="titulo"/>

    <TabPane fx:id="separadores" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Por fazer">
            <TableView fx:id="tabelaPorFazer">
                <columns>
                    <TableColumn text="Nº" prefWidth="60.0">
                        <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quarto" prefWidth="80.0">
                        <cellValueFactory><PropertyValueFactory property="quartoNumero"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Entrada" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="dataEntrada"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Saída" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="dataSaida"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Hóspedes" prefWidth="90.0">
                        <cellValueFactory><PropertyValueFactory property="numHospedes"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Total (€)" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder><Label text="Não tem reservas por fazer."/></placeholder>
            </TableView>
        </Tab>
        <Tab text="Em curso">
            <TableView fx:id="tabelaEmCurso">
                <columns>
                    <TableColumn text="Nº" prefWidth="60.0">
                        <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quarto" prefWidth="80.0">
                        <cellValueFactory><PropertyValueFactory property="quartoNumero"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Cartão" prefWidth="80.0">
                        <cellValueFactory><PropertyValueFactory property="cartao"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Check-in" prefWidth="120.0">
                        <cellValueFactory><PropertyValueFactory property="checkinEmTexto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Saída" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="dataSaida"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Total (€)" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder><Label text="Não tem nenhuma reserva em curso."/></placeholder>
            </TableView>
        </Tab>
        <Tab text="Histórico">
            <TableView fx:id="tabelaHistorico">
                <columns>
                    <TableColumn text="Nº" prefWidth="60.0">
                        <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quarto" prefWidth="80.0">
                        <cellValueFactory><PropertyValueFactory property="quartoNumero"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Entrada" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="dataEntrada"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Saída" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="dataSaida"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Estado" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="estadoTexto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Total (€)" prefWidth="110.0">
                        <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder><Label text="Ainda não tem reservas no histórico."/></placeholder>
            </TableView>
        </Tab>
    </TabPane>

    <HBox spacing="10.0">
        <Button text="Ver detalhes" onAction="#aoVerDetalhes"/>
        <Button text="Pedir extra" onAction="#aoPedirExtra"/>
    </HBox>
    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
