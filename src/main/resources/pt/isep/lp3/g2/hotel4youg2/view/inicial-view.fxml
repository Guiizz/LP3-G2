<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.InicialController">
    <left>
        <VBox spacing="8.0" prefWidth="230.0">
            <padding>
                <Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/>
            </padding>
            <Label text="Hotel4You" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label fx:id="utilizadorLabel"/>
            <Button text="Quartos" onAction="#aoAbrirQuartos" maxWidth="Infinity"/>
            <Button text="Reservas" onAction="#aoAbrirReservas" maxWidth="Infinity"/>
            <Button text="Pesquisar cliente" onAction="#aoPesquisarCliente" maxWidth="Infinity"/>
            <Button text="Registar cliente" onAction="#aoRegistarCliente" maxWidth="Infinity"/>
            <Button text="Sugestões e queixas" onAction="#aoAbrirSugestoes" maxWidth="Infinity"/>
            <Button text="Entregas (XML)" onAction="#aoAbrirEntregas" maxWidth="Infinity"/>
            <Button text="Decidir entregas" onAction="#aoDecidirEntregas" maxWidth="Infinity"/>
            <Button fx:id="servicosButton" text="Serviços" onAction="#aoAbrirServicos" maxWidth="Infinity"/>
            <Button fx:id="tarifasButton" text="Tarifas" onAction="#aoAbrirTarifas" maxWidth="Infinity"/>
            <Button fx:id="horarioButton" text="Horas e taxas" onAction="#aoAbrirHorario" maxWidth="Infinity"/>
            <Button fx:id="consultarSugestoesButton" text="Consultar sugestões e queixas"
                    onAction="#aoConsultarSugestoes" maxWidth="Infinity"/>
            <Button fx:id="contasButton" text="Contas" onAction="#aoAbrirContas" maxWidth="Infinity"/>
            <Button fx:id="criarContaButton" text="Criar conta" onAction="#aoCriarConta" maxWidth="Infinity"/>
            <Button fx:id="fornecedoresButton" text="Criar fornecedor" onAction="#aoCriarFornecedor"
                    maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Terminar sessão" onAction="#aoTerminarSessao" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="12.0">
            <Label text="Bem-vindo ao Hotel4You" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Escolha uma área no menu."/>
            <Button text="Testar ligação" onAction="#aoTestarLigacao"/>
            <Label fx:id="estadoLabel" wrapText="true" maxWidth="420"/>
        </VBox>
    </center>
</BorderPane>