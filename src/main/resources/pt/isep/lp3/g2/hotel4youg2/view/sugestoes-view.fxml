<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.SugestoesController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Registar sugestão ou queixa" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="NIF do cliente"/>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="nifField" promptText="9 algarismos" prefWidth="150.0" onAction="#aoProcurarCliente"/>
        <Button text="Procurar" onAction="#aoProcurarCliente"/>
        <Label fx:id="clienteLabel" style="-fx-font-weight: bold;"/>
    </HBox>

    <Label text="Tipo"/>
    <ComboBox fx:id="tipoCombo" promptText="Escolha o tipo" prefWidth="180.0"/>

    <Label text="Descrição"/>
    <TextArea fx:id="descricaoArea" wrapText="true" prefRowCount="7"/>
    <Label fx:id="contadorLabel" text="0/1000"/>

    <Button fx:id="registarButton" text="Registar" onAction="#aoRegistar" disable="true"/>
    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
