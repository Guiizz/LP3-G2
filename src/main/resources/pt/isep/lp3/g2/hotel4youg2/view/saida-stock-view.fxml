<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.SaidaStockController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Saída de materiais" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Ainda não há materiais em stock."/>
        </placeholder>
        <columns>
            <TableColumn text="Código" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="codigo"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Material" prefWidth="240.0">
                <cellValueFactory><PropertyValueFactory property="descricao"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Fornecedor" prefWidth="170.0">
                <cellValueFactory><PropertyValueFactory property="fornecedor"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Disponível" prefWidth="90.0">
                <cellValueFactory><PropertyValueFactory property="quantidade"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Quantidade:"/>
        <TextField fx:id="quantidadeField" promptText="ex.: 5" prefWidth="120.0" onAction="#aoRegistarSaida"/>
        <Button text="Registar saída" onAction="#aoRegistarSaida"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
