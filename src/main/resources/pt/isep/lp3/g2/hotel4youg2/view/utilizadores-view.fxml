<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.UtilizadoresController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Contas de utilizador" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colunaNome" text="Utilizador" prefWidth="180.0"/>
            <TableColumn fx:id="colunaPerfil" text="Perfil" prefWidth="130.0"/>
            <TableColumn fx:id="colunaEstado" text="Estado" prefWidth="100.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Desativar" onAction="#aoDesativar"/>
        <Button text="Reativar" onAction="#aoReativar"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>