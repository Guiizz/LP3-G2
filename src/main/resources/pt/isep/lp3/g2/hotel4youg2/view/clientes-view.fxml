<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="ecra" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.ClientesController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Lista de clientes" styleClass="titulo"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Pesquisar:"/>
        <TextField fx:id="filtroField" promptText="Nome, NIF, telefone ou email" prefWidth="280.0"
                   onKeyReleased="#aoFiltrar"/>
        <Label text="Procurar em:"/>
        <ComboBox fx:id="campoCombo" promptText="Todos" onAction="#aoFiltrar"/>
        <Button text="Limpar pesquisa" onAction="#aoLimparPesquisa"/>
    </HBox>

    <TableView fx:id="clientesTabela" VBox.vgrow="ALWAYS" onMouseClicked="#aoClicarNaTabela">
        <placeholder>
            <Label text="Não há clientes para mostrar."/>
        </placeholder>
        <columns>
            <TableColumn text="Nome" prefWidth="220.0">
                <cellValueFactory><PropertyValueFactory property="nome"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="NIF" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="nif"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Telefone" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="telemovel"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Email" prefWidth="220.0">
                <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="detalhesLabel" wrapText="true"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Ver reservas" onAction="#aoVerReservas"/>
        <Button text="Conta do cliente" onAction="#aoAbrirConta"/>
        <Button fx:id="registarButton" text="Registar este cliente" onAction="#aoRegistar"
                visible="false" managed="false"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
