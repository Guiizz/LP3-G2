<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.TarifasController">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Tarifas por noite"/>

    <TableView fx:id="tabela" prefHeight="260.0">
        <columns>
            <TableColumn text="Tipo" prefWidth="140.0">
                <cellValueFactory><PropertyValueFactory property="tipoTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Vista" prefWidth="140.0">
                <cellValueFactory><PropertyValueFactory property="vistaTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Preço por noite" prefWidth="160.0">
                <cellValueFactory><PropertyValueFactory property="valorNoiteTexto"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <TextField fx:id="campoPreco" promptText="Novo preço (ex.: 120.50)"/>
        <Button text="Guardar" onAction="#aoGuardar"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>