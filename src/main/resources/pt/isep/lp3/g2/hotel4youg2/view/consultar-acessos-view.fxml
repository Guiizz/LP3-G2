<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.ConsultarAcessosController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Registos de acesso" styleClass="titulo"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Cartão:"/>
        <TextField fx:id="cartaoField" promptText="ex.: C201 ou C000" prefWidth="170.0" onAction="#aoProcurarCartao"/>
        <Button text="Procurar por cartão" onAction="#aoProcurarCartao"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Quarto:"/>
        <TextField fx:id="quartoField" promptText="ex.: 201" prefWidth="170.0" onAction="#aoProcurarQuarto"/>
        <Button text="Procurar por quarto" onAction="#aoProcurarQuarto"/>
    </HBox>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Procure por um cartão ou por um quarto."/>
        </placeholder>
        <columns>
            <TableColumn text="Data e hora" prefWidth="150.0">
                <cellValueFactory><PropertyValueFactory property="registadoEmTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Cartão" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="cartao"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Local" prefWidth="150.0">
                <cellValueFactory><PropertyValueFactory property="localTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Reserva" prefWidth="90.0">
                <cellValueFactory><PropertyValueFactory property="reservaTexto"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Label fx:id="mensagemLabel" wrapText="true"/>
</VBox>
