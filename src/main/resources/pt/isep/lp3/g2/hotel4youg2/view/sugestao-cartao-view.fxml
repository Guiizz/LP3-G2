<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="420.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.SugestaoCartaoController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Sugestão ou queixa" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Label text="Número do cartão do quarto"/>
    <TextField fx:id="cartaoField" promptText="ex.: C201"/>
    <Label text="Tipo"/>
    <ComboBox fx:id="tipoCombo" promptText="Sugestão ou queixa" maxWidth="Infinity"/>
    <Label text="Descrição"/>
    <TextArea fx:id="descricaoArea" wrapText="true" prefRowCount="5"/>
    <Button text="Enviar" defaultButton="true" maxWidth="Infinity" onAction="#aoEnviar"/>
    <Label fx:id="mensagemLabel" wrapText="true" maxWidth="380"/>
</VBox>
