<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.AcessoCartaoController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="O meu cartão" styleClass="titulo"/>

    <Label fx:id="cartaoLabel"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Local:"/>
        <ComboBox fx:id="localCombo" promptText="Escolha o local" onAction="#aoEscolherLocal" prefWidth="190.0"/>
        <Label fx:id="quartoLabel" text="Quarto:"/>
        <TextField fx:id="quartoField" promptText="ex.: 201" prefWidth="80.0"/>
        <Button text="Picar" defaultButton="true" onAction="#aoPicar"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true" maxWidth="700"/>

    <Label text="As minhas passagens"/>
    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Data" prefWidth="110.0">
                <cellValueFactory><PropertyValueFactory property="dataTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Hora" prefWidth="80.0">
                <cellValueFactory><PropertyValueFactory property="horaTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Local" prefWidth="200.0">
                <cellValueFactory><PropertyValueFactory property="localTexto"/></cellValueFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="Ainda não picou o seu cartão."/>
        </placeholder>
    </TableView>
</VBox>
