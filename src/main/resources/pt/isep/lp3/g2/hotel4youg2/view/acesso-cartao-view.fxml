<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.AcessoCartaoController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label text="Picar o meu cartão" styleClass="titulo"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="O meu cartão:"/>
        <Label fx:id="cartaoLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </HBox>

    <HBox fx:id="picarBox" spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Local:"/>
        <ComboBox fx:id="localCombo" promptText="Escolha o local" prefWidth="220.0" visibleRowCount="12"/>
        <Button text="Picar" defaultButton="true" onAction="#aoPicar"/>
    </HBox>

    <Label fx:id="mensagemLabel" wrapText="true" maxWidth="700"/>

    <Label text="As minhas picagens"/>
    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Data e hora" prefWidth="150.0">
                <cellValueFactory><PropertyValueFactory property="registadoEmTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Cartão" prefWidth="100.0">
                <cellValueFactory><PropertyValueFactory property="cartao"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Local" prefWidth="200.0">
                <cellValueFactory><PropertyValueFactory property="localTexto"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Funcionário" prefWidth="220.0">
                <cellValueFactory><PropertyValueFactory property="funcionarioTexto"/></cellValueFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="Ainda não há picagens com o seu cartão."/>
        </placeholder>
    </TableView>
</VBox>
