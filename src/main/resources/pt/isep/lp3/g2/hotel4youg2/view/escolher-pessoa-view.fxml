<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" prefWidth="460.0" prefHeight="420.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isep.lp3.g2.hotel4youg2.controller.EscolherPessoaController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <Label fx:id="tituloLabel" styleClass="titulo"/>

    <TextField fx:id="pesquisaField" promptText="Pesquisar pelo nome ou pelo número" onKeyReleased="#aoPesquisar"/>

    <ListView fx:id="lista" VBox.vgrow="ALWAYS" onMouseClicked="#aoClicar">
        <placeholder>
            <Label text="Não há ninguém com esse nome ou número."/>
        </placeholder>
    </ListView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Cancelar" cancelButton="true" onAction="#aoCancelar"/>
        <Button text="Escolher" defaultButton="true" onAction="#aoEscolher"/>
    </HBox>
</VBox>
